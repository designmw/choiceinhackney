---
/**
 * Split hero — copy on the left, a real photo on the right.
 *
 * Used on the homepage. The decorative blob behind the photo echoes the swoosh
 * in the Choice in Hackney logo; it is aria-hidden and purely presentational.
 */
import type { ImageMetadata } from 'astro';
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import { Icon } from 'astro-icon/components';
import type { CallToAction } from '~/types';

export interface Props {
  tagline?: string;
  title?: string;
  subtitle?: string;
  actions?: CallToAction[];
  /** Short reassurance items shown under the buttons */
  notes?: Array<{ text: string; icon: string }>;
  image?: { src: ImageMetadata; alt: string };
}

const { tagline, title, subtitle, actions = [], notes = [], image } = Astro.props;
---

<section class="relative not-prose overflow-hidden bg-page md:-mt-[4.75rem]">
  {/* Soft warm wash behind the hero */}
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-primary/5 via-page to-page" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="pt-0 md:pt-[4.75rem] pointer-events-none"></div>

    <div class="grid items-center gap-10 py-12 md:py-16 lg:grid-cols-2 lg:gap-16 lg:py-20">
      <div class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
        {
          tagline && (
            <p class="text-sm md:text-base font-bold uppercase tracking-wide text-primary dark:text-accent">
              {tagline}
            </p>
          )
        }
        {
          title && (
            <h1 class="mt-3 font-heading font-bold tracking-tight text-heading text-4xl md:text-5xl lg:text-[3.4rem] leading-[1.08]">
              {title}
            </h1>
          )
        }
        {subtitle && <p class="mt-5 text-lg md:text-xl text-muted max-w-[46ch]">{subtitle}</p>}

        {
          actions.length > 0 && (
            <div class="mt-8 flex flex-col sm:flex-row flex-wrap gap-4">
              {actions.map((action) => (
                <Button {...action} class="w-full sm:w-auto" />
              ))}
            </div>
          )
        }

        {
          notes.length > 0 && (
            <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm text-muted">
              {notes.map(({ text, icon }) => (
                <li class="flex items-center gap-2">
                  <Icon name={icon} class="w-5 h-5 shrink-0 text-primary dark:text-accent" aria-hidden="true" />
                  {text}
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        image && (
          <div class="relative intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
            <div
              class="absolute -inset-4 -z-10 rounded-[2.5rem] bg-gradient-to-tr from-primary/25 via-accent/20 to-transparent blur-2xl"
              aria-hidden="true"
            />
            <Image
              src={image.src}
              alt={image.alt}
              width={1024}
              height={640}
              widths={[480, 768, 1024, 1600]}
              sizes="(max-width: 1023px) 100vw, 560px"
              loading="eager"
              fetchpriority="high"
              format="webp"
              layout="responsive"
              class="rounded-2xl shadow-2xl ring-1 ring-black/5 w-full object-cover aspect-[16/10]"
            />
          </div>
        )
      }
    </div>
  </div>
</section>
