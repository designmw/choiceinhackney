---
import Image from '~/components/common/Image.astro';
import { business } from '~/config/business';
import logo from '~/assets/images/brand/logo.png';
---

<Image
  src={logo}
  alt={`${business.name} logo`}
  width={200}
  height={72}
  loading="eager"
  fetchpriority="high"
  class="h-11 w-auto md:h-12"
  layout="constrained"
/>
