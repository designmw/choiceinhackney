---
export const prerender = false;

import AdminLayout from '~/layouts/AdminLayout.astro';
import { requireUser, isAdmin } from '~/lib/cms/auth';
import { storageAvailable } from '~/lib/cms/env';
import { listMedia, deleteMedia, updateAlt, mediaUrl, MAX_UPLOAD_BYTES } from '~/lib/cms/media';
import { log } from '~/lib/cms/activity';

const user = await requireUser(Astro.cookies);
if (!user) return Astro.redirect(`/admin/login?next=${encodeURIComponent(Astro.url.pathname)}`);
// Admin only. A viewer signs in to read the document lists and nothing else,
// so anything that changes the website redirects them away rather than showing
// a screen full of controls that will refuse to work.
if (!isAdmin(user)) return Astro.redirect('/admin');

let notice: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = String(form.get('id') ?? '');
  const action = String(form.get('action') ?? '');

  if (/^[a-f0-9]{32}$/.test(id)) {
    if (action === 'delete') {
      await deleteMedia(id);
      await log(user, 'deleted', `Deleted an image from the library`);
      notice = 'Image deleted. Any page still using it will show a broken image until you replace it.';
    } else if (action === 'alt') {
      await updateAlt(id, String(form.get('alt') ?? '').slice(0, 300));
      notice = 'Description saved.';
    }
  }
}

const ready = await storageAvailable();
const items = ready ? await listMedia() : [];

const sizeLabel = (bytes: number) =>
  bytes > 1024 * 1024 ? `${(bytes / 1024 / 1024).toFixed(1)} MB` : `${Math.max(1, Math.round(bytes / 1024))} KB`;
---

<AdminLayout title="Images" user={user}>
  <h1 class="font-heading text-2xl font-semibold tracking-tight">Images</h1>
  <p class="mt-2 text-slate-600 dark:text-slate-400">
    Pictures you can use on the website. Upload them here, then swap them in on any page.
  </p>

  {
    !ready && (
      <p
        role="alert"
        class="mt-6 rounded-md border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-800 dark:bg-amber-950 dark:text-amber-100"
      >
        <strong class="font-semibold">Image storage isn’t connected.</strong> Add the R2 bucket binding named
        <code>UPLOADS</code> to <code>wrangler.jsonc</code> — see <code>docs/live-editor.md</code>.
      </p>
    )
  }

  {
    notice && (
      <p
        role="status"
        class="mt-6 rounded-md border border-slate-300 bg-white px-4 py-3 text-sm dark:border-slate-700 dark:bg-slate-900"
      >
        {notice}
      </p>
    )
  }

  {
    ready && (
      <div class="mt-6 rounded-lg border border-dashed border-slate-300 bg-white p-4 dark:border-slate-700 dark:bg-slate-900">
        <label for="file" class="block text-sm font-medium">
          Add pictures
        </label>
        <input
          id="file"
          type="file"
          accept="image/*"
          multiple
          class="mt-2 block w-full text-sm file:me-3 file:rounded-md file:border-0 file:bg-primary file:px-3 file:py-2 file:text-sm file:font-medium file:text-white"
        />
        <p class="mt-2 text-sm text-slate-500">
          JPG, PNG, WebP or GIF, up to {Math.floor(MAX_UPLOAD_BYTES / 1024 / 1024)}MB each.
        </p>
        <p class="mt-2 text-sm" data-upload-status role="status" />
      </div>
    )
  }

  {
    items.length === 0 ? (
      ready && (
        <p class="mt-8 rounded-lg border border-dashed border-slate-300 px-4 py-10 text-center text-slate-500 dark:border-slate-700">
          No pictures yet.
        </p>
      )
    ) : (
      /* Two across on a phone, up to four on a desktop. */
      <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {items.map((item) => (
          <li class="flex flex-col overflow-hidden rounded-lg border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
            <img
              src={mediaUrl(item.id)}
              alt={item.alt || item.filename}
              loading="lazy"
              class="aspect-4/3 w-full bg-slate-100 object-cover dark:bg-slate-800"
            />
            <div class="flex flex-1 flex-col gap-2 p-3 text-sm">
              <div class="truncate font-medium" title={item.filename}>
                {item.filename}
              </div>
              <div class="text-xs text-slate-400">
                {item.width && item.height ? `${item.width}×${item.height} · ` : ''}
                {sizeLabel(item.size)}
              </div>

              <form method="POST" class="mt-auto flex flex-col gap-2">
                <input type="hidden" name="id" value={item.id} />
                <input type="hidden" name="action" value="alt" />
                <label for={`alt-${item.id}`} class="sr-only">
                  Description of this picture
                </label>
                <input
                  id={`alt-${item.id}`}
                  name="alt"
                  value={item.alt}
                  placeholder="Describe this picture"
                  class="w-full rounded-md border border-slate-300 bg-white px-2 py-1.5 text-xs dark:border-slate-700 dark:bg-slate-900"
                />
                <button
                  type="submit"
                  class="rounded-md border border-slate-300 px-2 py-1 text-xs transition hover:border-primary hover:text-primary dark:border-slate-700"
                >
                  Save description
                </button>
              </form>

              <form method="POST" data-confirm={`Delete ${item.filename}? Pages using it will show a broken image.`}>
                <input type="hidden" name="id" value={item.id} />
                <input type="hidden" name="action" value="delete" />
                <button
                  type="submit"
                  class="w-full rounded-md border border-slate-300 px-2 py-1 text-xs text-slate-500 transition hover:border-red-400 hover:text-red-700 dark:border-slate-700"
                >
                  Delete
                </button>
              </form>
            </div>
          </li>
        ))}
      </ul>
    )
  }

  <p class="mt-8 text-sm text-slate-500">
    Every picture needs a description. Screen readers read it aloud, and it is what search engines use to understand the
    image.
  </p>
</AdminLayout>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      if (!confirm(form.dataset.confirm ?? 'Are you sure?')) event.preventDefault();
    });
  });

  // Uploads happen one at a time rather than in one request: a single failure
  // then costs one picture instead of the whole batch, and the count gives some
  // sense of progress on a slow connection.
  const input = document.getElementById('file') as HTMLInputElement | null;
  const status = document.querySelector('[data-upload-status]');

  input?.addEventListener('change', async () => {
    const files = [...(input.files ?? [])];
    if (files.length === 0) return;

    input.disabled = true;
    let done = 0;
    const failed: string[] = [];

    for (const file of files) {
      if (status) status.textContent = `Uploading ${done + 1} of ${files.length}…`;
      const body = new FormData();
      body.append('file', file);

      try {
        const res = await fetch('/api/admin/upload', { method: 'POST', body });
        if (!res.ok) {
          const data = (await res.json().catch(() => ({}))) as { error?: string };
          throw new Error(data.error ?? 'Upload failed');
        }
        done++;
      } catch (err) {
        console.error('[cms] upload failed:', err);
        failed.push(`${file.name} (${err instanceof Error ? err.message : 'failed'})`);
      }
    }

    if (failed.length && status) {
      status.textContent = `Uploaded ${done}. Could not upload: ${failed.join(', ')}`;
      input.disabled = false;
      return;
    }

    location.reload();
  });
</script>
