---
import { Icon } from 'astro-icon/components';
import { business } from '~/config/business';

// Mobile-only sticky Call + Email bar. Sourced from business.ts; hidden on lg+
// (desktop has the header + footer contact). A charity's audience reaches us by
// phone or email rather than WhatsApp, so those are the two actions here.
// Remove <StickyContact /> from Layout.astro to disable it for a client.
const tel = business.telephone;
const telHref = `tel:${tel.replace(/\s/g, '')}`;
const emailHref = business.email ? `mailto:${business.email}` : undefined;
---

{
  tel && (
    <div class="lg:hidden fixed inset-x-0 bottom-0 z-40 flex border-t border-gray-200 dark:border-slate-700">
      <a
        href={telHref}
        class="flex flex-1 items-center justify-center gap-2 py-3.5 font-semibold text-white bg-primary hover:bg-secondary transition"
      >
        <Icon name="tabler:phone" class="w-5 h-5" aria-hidden="true" />
        Call us
      </a>
      {emailHref && (
        <a
          href={emailHref}
          class="flex flex-1 items-center justify-center gap-2 py-3.5 font-semibold text-white bg-gray-900 hover:bg-gray-800 dark:bg-slate-700 dark:hover:bg-slate-600 transition"
        >
          <Icon name="tabler:mail" class="w-5 h-5" aria-hidden="true" />
          Email us
        </a>
      )}
    </div>
  )
}
