---
/**
 * A photo alongside a block of copy, with an optional icon-led point list and
 * a call to action. Set `reverse` to put the image on the right.
 */
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { CallToAction, Widget } from '~/types';

export interface Props extends Widget {
  title?: string;
  tagline?: string;
  content?: string;
  items?: Array<{ title: string; description?: string; icon: string }>;
  actions?: CallToAction[];
  image?: { src: ImageMetadata; alt: string };
  /** Image on the right instead of the left */
  reverse?: boolean;
}

const {
  title,
  tagline,
  content,
  items = [],
  actions = [],
  image,
  reverse = false,
  id,
  isDark = false,
  classes = {},
  bg,
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl ${classes?.container ?? ''}`} bg={bg}>
  <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
    {
      image && (
        <div class:list={['relative', { 'lg:order-2': reverse }]}>
          <Image
            src={image.src}
            alt={image.alt}
            width={960}
            height={640}
            widths={[480, 768, 960]}
            sizes="(max-width: 1023px) 100vw, 520px"
            format="webp"
            layout="responsive"
            class="w-full rounded-2xl object-cover shadow-xl ring-1 ring-black/5 aspect-[4/3]"
          />
        </div>
      )
    }

    <div class:list={[{ 'lg:order-1': reverse }]}>
      {
        tagline && (
          <p class="text-sm md:text-base font-bold uppercase tracking-wide text-primary dark:text-accent">{tagline}</p>
        )
      }
      {
        title && (
          <h2 class="mt-3 font-heading text-3xl md:text-4xl font-bold tracking-tight text-heading leading-tight">
            {title}
          </h2>
        )
      }
      {content && <p class="mt-5 text-lg text-muted" set:html={content} />}

      {
        items.length > 0 && (
          <ul class="mt-8 space-y-5">
            {items.map(({ title: itemTitle, description, icon }) => (
              <li class="flex gap-4">
                <span class="mt-0.5 inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary dark:bg-accent/15 dark:text-accent">
                  <Icon name={icon} class="h-5 w-5" aria-hidden="true" />
                </span>
                <div>
                  <h3 class="font-semibold text-lg text-heading">{itemTitle}</h3>
                  {description && <p class="mt-1 text-muted">{description}</p>}
                </div>
              </li>
            ))}
          </ul>
        )
      }

      {
        actions.length > 0 && (
          <div class="mt-8 flex flex-col sm:flex-row flex-wrap gap-4">
            {actions.map((action) => (
              <Button {...action} class="w-full sm:w-auto" />
            ))}
          </div>
        )
      }
    </div>
  </div>
</WidgetWrapper>
